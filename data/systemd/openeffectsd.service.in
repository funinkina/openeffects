[Unit]
Description=OpenEffects webcam effects daemon
After=pipewire.service wireplumber.service graphical-session.target
Requires=pipewire.service

[Service]
Type=dbus
BusName=in.co.funinkina.Daemon
ExecStart=@bindir@/openeffectsd --start
Restart=on-failure

[Install]
WantedBy=graphical-session.target
