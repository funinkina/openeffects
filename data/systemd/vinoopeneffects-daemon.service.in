[Unit]
Description=vinoOpenEffects webcam effects daemon
After=pipewire.service wireplumber.service graphical-session.target
Requires=pipewire.service

[Service]
Type=dbus
BusName=io.github.karanshukla.vinoopeneffects.Daemon
ExecStart=@bindir@/vinoopeneffects-daemon --start
Restart=on-failure

[Install]
WantedBy=graphical-session.target
