  },
  {
    name: "Discord",
    path: "M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z",
  },
  {
    name: "OBS Studio",
    path: "M12,24C5.383,24,0,18.617,0,12S5.383,0,12,0s12,5.383,12,12S18.617,24,12,24z M12,1.109 C5.995,1.109,1.11,5.995,1.11,12C1.11,18.005,5.995,22.89,12,22.89S22.89,18.005,22.89,12C22.89,5.995,18.005,1.109,12,1.109z M6.182,5.99c0.352-1.698,1.503-3.229,3.05-3.996c-0.269,0.273-0.595,0.483-0.844,0.78c-1.02,1.1-1.48,2.692-1.199,4.156 c0.355,2.235,2.455,4.06,4.732,4.028c1.765,0.079,3.485-0.937,4.348-2.468c1.848,0.063,3.645,1.017,4.7,2.548 c0.54,0.799,0.962,1.736,0.991,2.711c-0.342-1.295-1.202-2.446-2.375-3.095c-1.135-0.639-2.529-0.802-3.772-0.425 c-1.56,0.448-2.849,1.723-3.293,3.293c-0.377,1.25-0.216,2.628,0.377,3.772c-0.825,1.429-2.315,2.449-3.932,2.756 c-1.244,0.261-2.551,0.059-3.709-0.464c1.036,0.302,2.161,0.355,3.191-0.011c1.381-0.457,2.522-1.567,3.024-2.935 c0.556-1.49,0.345-3.261-0.591-4.54c-0.7-1.007-1.803-1.717-3.002-1.969c-0.38-0.068-0.764-0.098-1.148-0.134 c-0.611-1.231-0.834-2.66-0.528-3.996L6.182,5.99z",
  },
  {
    name: "Slack",
    path: "M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z",
  },
];

const features: {
  icon:
    | "portrait"
    | "centerStage"
    | "background"
    | "studioLight"
    | "reactions"
    | "everywhere";
  title: string;
  body: string;
  badge?: string;
}[] = [
  {
    icon: "portrait",
    title: "Portrait Mode",
    body: "Background blur with feathered edges and temporal stability. No halo around your hair, no flicker between frames.",
  },
  {
    icon: "centerStage",
    title: "Center Stage",
    body: "Face and body-tracking crops and zooms to keep you or your whole group centered as you move around.",
  },
  {
    icon: "background",
    title: "Background Replacement",
    body: "Swap your room for a solid color or your own image. Whatever is behind you stays behind closed doors.",
  },
  {
    icon: "studioLight",
    title: "Studio Light",
    body: "Face-aware tone mapping lifts and separates you from the background, like a softbox rendered in software.",
  },
  {
    icon: "reactions",
    title: "Reactions",
    body: "Hand gestures trigger animated overlays: thumbs-up, heart, and more. Or fire them straight from the CLI.",
  },
  {
    icon: "everywhere",
    title: "Works Everywhere",
    body: "Zoom, Meet, Discord, OBS and the rest all see the improved feed. Set it once and forget it.",
  },
];

const pipeline = [
  {
    n: "01",
    title: "Turn it on",
    body: "OpenEffects picks up your camera and starts working in the background.",
  },
  {
    n: "02",
    title: "Pick your look",
    body: "Blur, framing, lighting and reactions, easily flip them on and off live.",
  },
  {
    n: "03",
    title: "Join any call",
    body: "Every app sees the improved feed automatically. No setup per app.",
  },
  {
    n: "04",
    title: "Stays private",
    body: "Everything runs on your device. Nothing is uploaded, ever.",
  },
];

const install = {
  flatpak: "flatpak install flathub in.co.funinkina.OpenEffects",
  arch: "sudo pacman -U openeffectsd-*-x86_64.pkg.tar.zst openeffects-*-x86_64.pkg.tar.zst",
  fedora:
    "sudo dnf install ./openeffectsd-*.x86_64.rpm ./openeffects-*.x86_64.rpm",
  ubuntu:
    "sudo apt install ./openeffectsd_*_amd64.deb ./openeffects_*_amd64.deb",
};

const cli = `openeffectsctl portrait-blur --on --strength 70
openeffectsctl center-stage --zoom tight
openeffectsctl background ~/Pictures/office.jpg
openeffectsctl react thumbs-up
openeffectsctl toggle reactions`;
---

<Layout>
  <Header />

  <main id="main">
    <section class="relative w-full overflow-x-hidden">
      <div class="mx-auto max-w-4xl px-6 pt-16 text-center sm:pt-24">
        <h1
          class="mx-auto text-6xl font-black leading-[1.05] tracking-tight sm:text-7xl"
        >
          Your next video call deserves
          <span class="text-accent"> the best.</span>
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          Background blur, auto-framing, studio light and fun reactions, added
          to <span class="font-medium text-fg"
            >any app that uses your camera.</span
          > Set it once and Zoom, Meet, Discord and OBS all get the upgrade.
        </p>
      </div>

      <div class="mt-14 sm:mt-16 mb-14">
        <Carousel />
      </div>

      <div class="mx-auto max-w-3xl pt-12 text-center sm:pb-10">
        <div class="flex flex-wrap items-center justify-center gap-3">
          <FlathubBadge href={FLATHUB} />
          <a
            href={RELEASES}
            class="btn btn-ghost h-13 py-0 sm:h-14 rounded-xl text-xl"
          >
            <svg
              class="h-7 w-7"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"><path d={ghPath}></path></svg
            >
            GitHub releases
          </a>
        </div>

        <p class="mt-6 text-[0.8rem] tracking-wide text-muted">
          Free & open source · Works with every app · No GPU required
        </p>
      </div>
    </section>

    <section class="border-y border-line bg-surface">
      <div class="mx-auto max-w-6xl px-6 py-8">
        <div
          class="flex flex-col justify-center items-start gap-6 sm:flex-row sm:items-center sm:gap-10"
        >
          <div
            class="flex shrink-0 items-center gap-6 text-muted mask-[linear-gradient(to_right,#000_0%,#000_55%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_right,#000_0%,#000_55%,transparent_100%)]"
          >
            {
              appIcons.map((app) => (
                <svg
                  class="h-7 w-7 shrink-0 transition-colors hover:text-fg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  role="img"
                  aria-label={app.name}
                >
                  <title>{app.name}</title>
                  <path d={app.path} />
                </svg>
              ))
            }
          </div>
          <p class="max-w-md text-[0.95rem] leading-relaxed text-muted">
            <span class="font-semibold text-fg">…and every other app</span> that can
            open your camera. Set it once, upgrade them all.
          </p>
        </div>
      </div>
    </section>

    <section
      id="overview"
      class="relative isolate scroll-mt-20 overflow-hidden"
    >
      <span
        aria-hidden="true"
        class="pointer-events-none absolute bottom-28 left-0 -z-10 hidden rotate-180 text-8xl font-black tracking-tight text-accent/10 [writing-mode:vertical-rl] lg:block"
        >OVERVIEW</span
      >
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <div class="max-w-2xl">
          <h2
            class="mt-5 text-3xl font-bold tracking-tight sm:text-[2.6rem] sm:leading-[1.1]"
          >
            One helper between your camera and everything else.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-muted">
            No extra window to keep open. OpenEffects works quietly in the
            background and hands every app a better version of your camera.
          </p>
        </div>

        <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            pipeline.map((step) => (
              <li class="card relative rounded p-6">
                <span class="text-sm font-semibold text-accent">{step.n}</span>
                <h3 class="mt-3 text-xl font-semibold text-fg">{step.title}</h3>
                <p class="mt-1.5 text-[0.92rem] leading-relaxed text-muted">
                  {step.body}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="features"
      class="relative isolate scroll-mt-20 overflow-hidden border-y border-line bg-surface"
    >
      <span
        aria-hidden="true"
        class="pointer-events-none absolute bottom-28 left-0 -z-10 hidden rotate-180 text-8xl font-black tracking-tight text-accent/10 [writing-mode:vertical-rl] lg:block"
        >FEATURES</span
      >
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <div class="max-w-3xl">
          <h2
            class="mt-5 text-3xl font-bold tracking-tight sm:text-[2.6rem] sm:leading-[1.1]"
          >
            Everything a modern camera does <span class="text-muted"
              >without the closed-source camera app.</span
            >
          </h2>
        </div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((f) => (
              <FeatureCard
                icon={f.icon}
                title={f.title}
                body={f.body}
                badge={f.badge}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section id="install" class="relative isolate scroll-mt-20 overflow-hidden">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute bottom-28 left-0 -z-10 hidden rotate-180 text-8xl font-black tracking-tight text-accent/10 [writing-mode:vertical-rl] lg:block"
        >INSTALL</span
      >
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <div
          class="flex gap-8 justify-between sm:flex-col md:flex-col lg:flex-row"
        >
          <div class="max-w-xl md:mx-auto sm:mx-auto">
            <h2
              class="mt-5 text-3xl font-bold tracking-tight sm:text-[2.6rem] sm:leading-[1.1]"
            >
              Get it from Flathub.
            </h2>
            <p class="mt-5 leading-relaxed text-muted">
              The Flatpak is the quickest path on any distro. Prefer native
              packages? Grab the <code class="font-medium text-fg">.pkg</code>, <code
                class="font-medium text-fg">.rpm</code
              > or <code class="font-medium text-fg">.deb</code> from the latest release
              and install them together.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <FlathubBadge href={FLATHUB} />
              <a
                href={RELEASES}
                class="btn btn-ghost h-13 rounded-xl py-0 sm:h-14"
                >Direct packages</a
              >
              <a href={DOCS} class="btn btn-ghost h-13 rounded-xl py-0 sm:h-14"
                >CLI reference</a
              >
            </div>
            <p class="mt-6 text-[0.8rem] leading-relaxed text-muted">
              AUR, COPR and a PPA are coming soon.
            </p>
          </div>

          <div
            class="justify-end w-xl max-w-xl min-w-xl md:mx-auto md:pt-6 sm:mx-auto sm-pt-6"
          >
            <div
              role="tablist"
              aria-label="Install method"
              class="mb-3 flex flex-wrap gap-2"
            >
              <button
                role="tab"
                aria-selected="true"
                class="tab is-active rounded-full"
                data-tab="flatpak">Flatpak</button
              >
              <button
                role="tab"
                aria-selected="false"
                class="tab rounded-full"
                data-tab="arch">Arch</button
              >
              <button
                role="tab"
                aria-selected="false"
                class="tab rounded-full"
                data-tab="fedora">Fedora / RHEL</button
              >
              <button
                role="tab"
                aria-selected="false"
                class="tab rounded-full"
                data-tab="ubuntu">Ubuntu / Debian</button
              >
            </div>

            <div data-panel="flatpak">
              <CodeBlock code={install.flatpak} label="flatpak" />
            </div>
            <div data-panel="arch" class="hidden">
              <CodeBlock code={install.arch} label="pacman" />
            </div>
            <div data-panel="fedora" class="hidden">
              <CodeBlock code={install.fedora} label="dnf" />
            </div>
            <div data-panel="ubuntu" class="hidden">
              <CodeBlock code={install.ubuntu} label="apt" />
            </div>

            <p
              class="mb-2 mt-8 text-[11px] uppercase tracking-wider text-muted"
            >
              Then drive it from anywhere
            </p>
            <CodeBlock code={cli} label="openeffectsctl" />
          </div>
        </div>
      </div>
    </section>

    <section
      id="gnome"
      class="relative isolate scroll-mt-20 overflow-hidden border-y border-line bg-surface"
    >
      <span
        aria-hidden="true"
        class="pointer-events-none absolute bottom-28 left-0 -z-10 hidden rotate-180 text-8xl font-black tracking-tight text-accent/10 [writing-mode:vertical-rl] lg:block"
        >EXTENSION</span
      >
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div class="max-w-xl">
            <p class="eyebrow">Coming Soon</p>
            <h2
              class="mt-5 text-3xl font-bold tracking-tight sm:text-[2.6rem] sm:leading-[1.1]"
            >
              Toggle effects from the top bar.
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-muted">
              The companion GNOME extension drops OpenEffects straight into
              Quick Settings. Flip blur, framing, studio light and reactions on
              or off mid-call. No window to find, no command to type.
            </p>
            <ul class="mt-7 flex flex-col gap-3 text-[0.95rem] text-fg">
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
                ></span>
                One tap in Quick Settings to switch any effect on or off.
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
                ></span>
                A live indicator, so you always know what's running.
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
                ></span>
                Talks to the same background daemon that is always in sync with the
                app and CLI.
              </li>
            </ul>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <GnomeBadge href={GNOME_EXTENSION} />
              <a
                href={GITHUB}
                class="btn btn-ghost h-13 rounded-xl py-0 sm:h-14"
                >View source</a
              >
            </div>
          </div>

          <div
            class="mx-auto w-fit overflow-hidden rounded-xl border border-line bg-page"
          >
            <img
              src="/gnome-extension.png"
              alt="OpenEffects controls in the GNOME Quick Settings panel"
              width="1022"
              height="1453"
              loading="lazy"
              class="h-125 w-auto"
            />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // copy-to-clipboard
    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.dataset.clipboard ?? "";
        const label = btn.querySelector(".copy-label");
        try {
          await navigator.clipboard.writeText(text);
          const prev = label?.textContent ?? "Copy";
          if (label) label.textContent = "Copied";
          btn.classList.add("text-accent");
          window.setTimeout(() => {
            if (label) label.textContent = prev;
            btn.classList.remove("text-accent");
          }, 1600);
        } catch {
          /* clipboard unavailable */
        }
      });
    });

    // install tabs
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
    const panels = document.querySelectorAll<HTMLElement>("[data-panel]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const name = tab.dataset.tab;
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", String(active));
        });
        panels.forEach((p) =>
          p.classList.toggle("hidden", p.dataset.panel !== name),
        );
      });
    });
  </script>
</Layout>
