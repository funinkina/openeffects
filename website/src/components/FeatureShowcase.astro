---
// Interactive features section: the tab list acts like the daemon's effect
// toggles, and the viewfinder applies the selected effect live (CSS only).
// Auto-advances until the user takes over.
// variant "split" = preview beside a vertical tab list (default).
// variant "hero"  = boxed, preview centered, toggles in a row underneath;
//                   inactive toggles collapse to icon-only.
interface Props {
  variant?: "split" | "hero";
}
const { variant = "split" } = Astro.props;
const isHero = variant === "hero";

const rootClass = isHero
  ? "flex flex-col-reverse gap-3 rounded-2xl border border-line bg-surface p-4"
  : "grid items-start gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-14";
const previewClass = isHero
  ? "mx-auto w-full max-w-3xl"
  : "sticky top-16 z-20 bg-surface pb-4 lg:top-24 lg:order-2 lg:pb-0";
const tablistClass = isHero
  ? "flex flex-row flex-wrap justify-center gap-2"
  : "flex flex-col gap-2 lg:order-1";
const tabClass = isHero
  ? "feature-tab feature-tab--pill relative flex items-center gap-0 rounded-full px-3.5 py-2.5"
  : "feature-tab relative flex items-center gap-3.5 rounded-md px-3 py-3 text-left sm:px-5";
const iconClass = isHero
  ? "tab-icon shrink-0 text-muted [&_svg]:h-6 [&_svg]:w-6 [&_svg]:fill-current"
  : "tab-icon shrink-0 text-muted [&_svg]:h-8 [&_svg]:w-8 [&_svg]:fill-current";
const titleClass = isHero
  ? "tab-title font-semibold text-fg"
  : "tab-title text-lg font-semibold text-fg";

const features = [
  {
    id: "portrait",
    title: "Portrait Mode",
