// reactions demo: waves of one emoji at a time, streaming bottom-to-top.
// Each wave reuses the same spread of positions/sizes, phase-shifted by 2s.
const reactionWaves = ["👍", "❤️", "🎉"].map((emoji, w) => ({
  emoji,
  spans: [
    { left: 16, size: "text-3xl", d: 0, tilt: -12 },
    { left: 62, size: "text-4xl", d: 0.3, tilt: 9 },
    { left: 34, size: "text-2xl", d: 0.55, tilt: -7 },
    { left: 78, size: "text-3xl", d: 0.8, tilt: 14 },
    { left: 48, size: "text-3xl", d: 1.05, tilt: -10 },
    { left: 88, size: "text-2xl", d: 1.3, tilt: 6 },
  ].map((s) => ({ ...s, d: s.d + w * 2 })),
}));
---

<div class={rootClass} data-showcase data-auto="on">
  <!-- live preview -->
  <div class={previewClass}>
    <div
      class="demo relative aspect-video w-full select-none overflow-hidden rounded-2xl border border-haze/15 bg-ink-deep shadow-lens"
      id="feature-demo"
      data-effect="portrait"
      role="img"
      aria-label="Simulated webcam preview demonstrating the selected effect live."
    >
      <div class="scene absolute inset-0">
        <!-- the real room: sharp by default so the effects have something to work on -->
        <div class="room absolute -inset-8">
          <div
            class="absolute inset-0"
            style="background: radial-gradient(120% 90% at 25% 20%, #2a2540 0%, #1a1726 45%, #121019 100%);"
          >
          </div>
          <div
            class="absolute left-[10%] top-[13%] h-[38%] w-[19%] border border-white/25 bg-[linear-gradient(180deg,#3d6a94,#22405e)]"
          >
            <span class="absolute inset-y-0 left-1/2 w-px bg-white/25"></span>
            <span class="absolute inset-x-0 top-1/2 h-px bg-white/25"></span>
          </div>
          <div
            class="absolute right-[11%] top-[20%] flex w-[17%] items-end gap-[5%] border-b-4 border-[#0a1119]"
          >
            <span class="h-9 w-[15%] bg-[#7f5a44]"></span>
            <span class="h-7 w-[15%] bg-[#4f6d7a]"></span>
            <span class="h-10 w-[15%] bg-[#8a6d56]"></span>
            <span class="h-6 w-[15%] bg-[#5d7a5f]"></span>
            <span class="h-8 w-[15%] bg-[#6e5a70]"></span>
          </div>
          <span
            class="absolute left-[70%] top-[58%] h-24 w-24 rounded-full bg-record/20 blur-xl"
          ></span>
          <span
            class="absolute left-[4%] top-[64%] h-20 w-20 rounded-full bg-lens/25 blur-xl"
          ></span>
        </div>

        <!-- replacement background -->
        <div class="alt absolute -inset-8 opacity-0">
          <div
            class="absolute inset-0"
            style="background: linear-gradient(180deg, #27476b 0%, #a86544 62%, #dd9c5b 100%);"
          >
          </div>
          <span
            class="absolute left-[62%] top-[32%] h-14 w-14 rounded-full bg-[#ffd98a] shadow-[0_0_44px_14px_rgba(255,208,122,0.45)]"
          ></span>
          <span
            class="absolute left-[-10%] bottom-0 h-[24%] w-[72%] rounded-t-[100%] bg-[#1c2f47]"
          ></span>
          <span
            class="absolute right-[-14%] bottom-0 h-[32%] w-[66%] rounded-t-[100%] bg-[#16263a]"
          ></span>
        </div>

        <!-- vignette -->
        <div
          class="pointer-events-none absolute inset-0"
          style="background: radial-gradient(80% 70% at 50% 62%, transparent 40%, rgba(4,10,18,0.55) 100%);"
        >
        </div>

        <!-- studio light wash -->
        <div
          class="glow pointer-events-none absolute inset-0 opacity-0"
          style="background: radial-gradient(48% 42% at 50% 30%, rgba(255,240,206,0.18), transparent 70%);"
        >
        </div>

        <!-- subject, always sharp -->
        <svg
          class="subject absolute bottom-0 left-1/2 h-[86%] w-auto -translate-x-1/2"
          viewBox="0 0 220 190"
          fill="none"
          aria-hidden="true"
        >
          <defs>
            <linearGradient
              id="fs-subject"
              x1="110"
              y1="8"
              x2="110"
              y2="190"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0" stop-color="#f6f5fb"></stop>
              <stop offset="0.65" stop-color="#d9d4f0"></stop>
              <stop offset="1" stop-color="#a79fd8"></stop>
            </linearGradient>
          </defs>
          <path
            d="M14 190 C14 138 55 112 110 112 C165 112 206 138 206 190 Z"
            fill="url(#fs-subject)"></path>
          <circle cx="110" cy="60" r="44" fill="url(#fs-subject)"></circle>
          <path
            d="M76 34 A44 44 0 0 0 76 86"
            stroke="#fff"
            stroke-opacity="0.5"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
      </div>

      <!-- tracking reticle (center stage) -->
      <svg
        class="reticle absolute left-1/2 top-[26%] h-14 w-14 -translate-x-1/2 text-lens opacity-0"
        viewBox="0 0 100 100"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12 28 V12 H28 M72 12 H88 V28 M88 72 V88 H72 M28 88 H12 V72"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"></path>
        <circle cx="50" cy="50" r="2.5" fill="currentColor"></circle>
      </svg>

      <!-- floating reactions -->
      <div
        class="fx pointer-events-none absolute inset-0 opacity-0"
        aria-hidden="true"
      >
        {
          reactionWaves.map((wave) =>
            wave.spans.map((s) => (
              <span
                class:list={["absolute bottom-[-10%]", s.size]}
                style={`left:${s.left}%; animation-delay:${s.d}s; --tilt:${s.tilt}deg`}
              >
                {wave.emoji}
              </span>
            )),
          )
        }
      </div>

      <!-- REC HUD -->
      <div
        class="hud absolute left-4 top-3.5 flex items-center gap-2 text-[11px] tracking-wider text-white/90"
      >
        <span
          class="rec-dot inline-block h-2.5 w-2.5 rounded-full bg-record shadow-[0_0_10px_2px_rgba(255,233,77,0.7)]"
        ></span>
        REC
      </div>
      <div
        class="hud absolute right-4 top-3.5 text-[11px] tracking-wider text-white/70"
      >
        1080P · 30FPS
      </div>

      <!-- app window chrome (works everywhere) -->
      <div
        class="appbar absolute inset-x-0 top-0 flex items-center gap-2.5 bg-black/50 px-4 py-2.5 text-[11px] tracking-wider text-white/75 opacity-0 backdrop-blur-sm"
        aria-hidden="true"
      >
        <span class="flex gap-1.5">
          <span class="h-3 w-3 rounded-full bg-red-500"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
          <span class="h-3 w-3 rounded-full bg-green-400"></span>
        </span>
        <span>YOUR CAMERA IN</span>
        <span class="appcycle relative h-4 w-24 font-semibold text-white">
          <span>ZOOM</span>
          <span>MEET</span>
          <span>DISCORD</span>
          <span>OBS</span>
        </span>
      </div>

      <!-- active effect chip -->
      <div
        class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-md border border-lens/50 bg-lens/15 px-2 py-1 text-[10px] uppercase tracking-wider text-white sm:bottom-4 sm:left-4 sm:text-[11px]"
      >
        <span
          class="h-1.5 w-1.5 rounded-full bg-lens shadow-[0_0_8px_1px_rgba(86,167,234,0.8)]"
        ></span>
        <span class="effect-label">Portrait Mode</span>
        <span class="text-white/55">ON</span>
      </div>
    </div>

    <!-- active feature description; stacked in one cell so height stays stable -->
    <div class="mt-5 grid">
      {
        features.map((f, i) => (
          <p
            class:list={[
              "feature-desc mx-auto col-start-1 w-4/5 row-start-1 text-center text-[0.95rem] leading-relaxed text-muted transition-opacity duration-300",
              i !== 0 && "opacity-0",
            ]}
            data-desc={f.id}
          >
            {f.body}
          </p>
        ))
      }
    </div>
  </div>

  <!-- effect toggles -->
  <div
    class={tablistClass}
    role="tablist"
    aria-label="Features"
    aria-orientation={isHero ? "horizontal" : "vertical"}
  >
    {
      features.map((f, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls="feature-demo"
          class:list={[tabClass, i === 0 && "is-active"]}
          data-feature={f.id}
          data-title={f.title}
        >
          <span class={iconClass} set:html={f.icon} aria-hidden="true" />
          <span class={titleClass}>{f.title}</span>
        </button>
      ))
    }
  </div>
</div>

<style>
  .feature-tab {
    border: 1px solid transparent;
    cursor: pointer;
    overflow: hidden;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .feature-tab:hover,
  .feature-tab.is-active {
    color: var(--color-accent);
    background: var(--color-page);
    border-color: var(--color-line);
  }
  .feature-tab.is-active .tab-icon,
  .feature-tab.is-active .tab-title {
    color: var(--color-accent);
  }

  /* hero pills: the active toggle reveals its label, others collapse to the
     icon. max-width + opacity animate; the pill (and its neighbors) reflow
     smoothly as the label slides in. */
  .feature-tab--pill .tab-title {
    max-width: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition:
      max-width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      margin-left 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease;
  }
  .feature-tab--pill.is-active .tab-title {
    max-width: 16rem;
    margin-left: 0.5rem;
    opacity: 1;
  }

  /* auto-advance progress along the bottom of the active tab */
  [data-auto="on"] .feature-tab.is-active::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--color-accent);
    transform-origin: left;
    animation: tab-progress 5s linear forwards;
  }
  @keyframes tab-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* ---- the effects themselves ---- */
  .scene {
    transform-origin: 50% 60%;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .room,
  .alt {
    transition:
      filter 0.7s ease,
      opacity 0.6s ease;
  }
  .subject {
    filter: drop-shadow(0 6px 22px rgba(129, 117, 246, 0.35));
    transition: filter 0.6s ease;
  }
  .glow,
  .fx,
  .appbar,
  .reticle,
  .hud {
    transition: opacity 0.45s ease;
  }
  .demo[data-effect="portrait"] .room {
    filter: blur(16px) saturate(1.05);
  }

  .demo[data-effect="centerStage"] .scene {
    transform: scale(1.3);
  }
  .demo[data-effect="centerStage"] .room {
    animation: cam-pan 7s ease-in-out infinite alternate;
  }
  .demo[data-effect="centerStage"] .reticle {
    opacity: 1;
    animation: reticle 4.5s ease-in-out infinite;
  }

  .demo[data-effect="background"] .alt {
    opacity: 1;
  }

  .demo[data-effect="studioLight"] .glow {
    opacity: 1;
  }
  .demo[data-effect="studioLight"] .room {
    filter: brightness(0.7) saturate(0.9);
  }
  .demo[data-effect="studioLight"] .subject {
    filter: brightness(1.05) drop-shadow(0 0 16px rgba(255, 241, 205, 0.25));
  }

  .demo[data-effect="reactions"] .fx {
    opacity: 1;
  }
  .demo[data-effect="reactions"] .fx span {
    opacity: 0;
    /* per-span animation-delay and --tilt come from the inline style; rotate
       is a separate property, so the keyframe transforms don't reset it */
    rotate: var(--tilt, 0deg);
    animation: float-up 6s linear infinite;
  }

  .demo[data-effect="everywhere"] .appbar {
    opacity: 1;
  }
  .demo[data-effect="everywhere"] .hud {
    opacity: 0;
  }
  .demo[data-effect="everywhere"] .room {
    filter: blur(16px) saturate(1.05);
  }

  .appcycle span {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: app-swap 8s linear infinite;
  }
  .appcycle span:nth-child(2) {
    animation-delay: 2s;
  }
  .appcycle span:nth-child(3) {
    animation-delay: 4s;
  }
  .appcycle span:nth-child(4) {
    animation-delay: 6s;
  }

  @keyframes cam-pan {
    from {
      transform: translateX(-2.5%);
    }
    to {
      transform: translateX(2.5%);
    }
  }
  /* rise takes the first half of the loop, with a long fade that dissolves
     the emoji well before the top edge; the dead time keeps waves distinct */
  @keyframes float-up {
    0% {
      transform: translateY(0) scale(0.7);
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    28% {
      opacity: 0.85;
    }
    48%,
    100% {
      transform: translateY(-290px) scale(1.05);
      opacity: 0;
    }
  }
  @keyframes app-swap {
    0%,
    21% {
      opacity: 1;
    }
    25%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene,
    .room,
    .alt,
    .subject,
    .glow,
    .fx,
    .appbar,
    .reticle,
    .hud,
    .feature-tab--pill .tab-title {
      transition: none;
    }
    .demo[data-effect="centerStage"] .room,
    .demo[data-effect="centerStage"] .reticle,
    .demo[data-effect="reactions"] .fx span,
    .appcycle span,
    [data-auto="on"] .feature-tab.is-active::after {
      animation: none;
    }
    /* static fallbacks: no auto-advance, visible emoji, first app name */
    [data-auto="on"] .feature-tab.is-active::after {
      content: none;
    }
    .demo[data-effect="reactions"] .fx span:nth-child(-n + 6) {
      opacity: 1;
      transform: translateY(-70px);
    }
    .appcycle span:first-child {
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-showcase]").forEach((root) => {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>(".feature-tab"),
    );
    const demo = root.querySelector<HTMLElement>(".demo");
    const label = root.querySelector<HTMLElement>(".effect-label");
    const descs = Array.from(
      root.querySelectorAll<HTMLElement>(".feature-desc"),
    );
    if (!demo || !tabs.length) return;
    let current = 0;

    const select = (i: number) => {
      current = ((i % tabs.length) + tabs.length) % tabs.length;
      tabs.forEach((t, j) => {
        t.classList.toggle("is-active", j === current);
        t.setAttribute("aria-selected", String(j === current));
      });
      const id = tabs[current].dataset.feature ?? "";
      demo.dataset.effect = id;
      if (label) label.textContent = tabs[current].dataset.title ?? "";
      descs.forEach((d) =>
        d.classList.toggle("opacity-0", d.dataset.desc !== id),
      );
    };

    tabs.forEach((t, i) => t.addEventListener("click", () => select(i)));

    root.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
      if (!(e.target as HTMLElement).closest("[role='tablist']")) return;
      e.preventDefault();
      select(current + (e.key === "ArrowDown" ? 1 : -1));
      tabs[current].focus();
    });

    // auto-advance is driven by the progress bar finishing; a manual
    // selection restarts the bar, so the slideshow resumes from there
    root.addEventListener("animationend", (e) => {
      if (e.animationName.includes("tab-progress")) select(current + 1);
    });
  });
</script>
