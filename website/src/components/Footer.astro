---
import FlathubBadge from "./FlathubBadge.astro";
import {
  GITHUB,
  RELEASES,
  DOCS,
  LICENSE,
  FLATHUB,
  AUTHOR,
  AUTHOR_SITE,
  AUTHOR_GITHUB,
  AUTHOR_BMC,
  AUTHOR_TWITTER,
  ghPath,
} from "../consts";
---

<footer class="bg-accent text-white">
  <div class="mx-auto max-w-6xl px-6">
    <div class="py-16 sm:py-24">
      <div class="flex items-center gap-4">
        <img
          src="/openeffects.svg"
          alt=""
          width="112"
          height="112"
          class="h-20 w-20 sm:h-48 sm:w-48"
        />
        <div>
          <h2
            class="text-[clamp(2.75rem,11vw,7.5rem)] font-black text-white/30 leading-[0.9] tracking-tight"
          >
            OpenEffects
          </h2>
          <p class="mt-5 max-w-md text-lg text-white/40 sm:text-2xl">
            Better webcam effects for Linux.
          </p>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <FlathubBadge href={FLATHUB} />
        <a href={GITHUB} class="btn btn-ghost h-13 rounded-xl py-0 sm:h-14"
          >View source</a
        >
      </div>
    </div>
  </div>

  <div
    class="mx-auto flex max-w-6xl flex-col justify-between gap-10 border-t border-white/20 px-6 py-10 sm:flex-row"
  >
    <div class="flex flex-col justify-between">
      <div
        class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.85rem] text-white/70"
      >
        <a href={FLATHUB} class="transition-colors hover:text-white">Flathub</a>
        <a href={GITHUB} class="transition-colors hover:text-white">GitHub</a>
        <a href={RELEASES} class="transition-colors hover:text-white"
          >Releases</a
        >
        <a href={DOCS} class="transition-colors hover:text-white">CLI Docs</a>
        <a href={LICENSE} class="transition-colors hover:text-white">GPL-3.0</a>
      </div>
      <div>
        <p class="text-white/70 text-sm">&#xA9; 2026 Aryan Kushwaha.</p>
      </div>
    </div>

    <div class="sm:text-right">
      <a
        href={AUTHOR_SITE}
        class="text-sm font-bold transition-colors hover:text-white/70"
        >{AUTHOR}</a
      >
      <p class="text-[11px] text-white/60">Creator & maintainer</p>
      <div
        class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.85rem] text-white/70 sm:justify-end"
      >
        <a
          href={AUTHOR_GITHUB}
          class="inline-flex items-center gap-2 transition-colors hover:text-white"
          aria-label="Aryan Kushwaha on GitHub"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"><path d={ghPath}></path></svg
          >
          @funinkina
        </a>
        <a
          href={AUTHOR_BMC}
          class="inline-flex items-center gap-2 transition-colors hover:text-white"
          aria-label="Aryan Kushwaha on Buy Me a Coffee"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4Z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
          @funinkina
        </a>
        <a
          href={AUTHOR_TWITTER}
          class="inline-flex items-center gap-2 transition-colors hover:text-white"
          aria-label="Aryan Kushwaha on Twitter"
        >
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            ><path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path></svg
          >
          @funinkina
        </a>
      </div>
    </div>
  </div>
</footer>
