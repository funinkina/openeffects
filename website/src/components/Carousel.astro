---
const slides = [
  {
    title: "Portrait Mode",
    caption: "Blurred room, sharp you",
    image: "/hero/sample.webp",
  },
  {
    title: "Center Stage",
    caption: "Stay framed as you move",
    image: "/hero/sample-2.webp",
  },
  {
    title: "Background Replacement",
    caption: "Swap your room for anything",
    image: "/hero/backgrounds.webp",
  },
  {
    title: "Studio Light",
    caption: "Soft, even lighting",
    image: "/hero/studio.webp",
  },
  {
    title: "Reactions",
    caption: "Wave, thumbs-up, heart, whatever your hands desire!",
    image: "/hero/reactions.webp",
  },
];
---

<div class="relative w-full overflow-visible" data-carousel>
  <div class="relative mx-auto" data-stage>
    <!-- sizer: keeps the stage the same height as the front card, responsively -->
    <div class="invisible mx-auto aspect-16/10 w-[82vw] max-w-155"></div>

    {
      slides.map((s, i) => (
        <figure
          class="carousel-slide absolute left-1/2 top-0 aspect-16/10 w-[82vw] max-w-155 cursor-pointer overflow-hidden rounded-3xl bg-surface shadow-2xl"
          data-slide={i}
        >
          <img
            src={s.image}
            alt={s.title}
            width="640"
            height="360"
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={i === 0 ? "high" : "auto"}
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-black/70 via-black/25 to-transparent" />
          <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-6 text-left sm:p-8">
            <div>
              <p class="text-xl font-bold text-white sm:text-2xl">{s.title}</p>
              <p class="mt-1 text-sm text-white/80">{s.caption}</p>
            </div>
            <span class="shrink-0 rounded-full border border-white/30 bg-white/15 px-2.5 py-1 text-[10px] uppercase tracking-wider text-white/90">
              Preview
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .carousel-slide {
    transform: translate(-50%, 0);
    transform-origin: center center;
    will-change: transform, opacity;
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.5s ease,
      filter 0.5s ease;
  }
  .carousel-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: var(--color-line-strong);
    transition:
      background-color 0.15s ease,
      width 0.15s ease;
    cursor: pointer;
  }
  .carousel-dot.is-active {
    width: 1.4rem;
    background: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-slide {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>("[data-slide]"),
    );
    const n = slides.length;
    if (!n) return;

    let current = 0;

    const layout = () => {
      slides.forEach((el, i) => {
        let rel = i - current;
        if (rel > n / 2) rel -= n;
        if (rel < -n / 2) rel += n;

        const depth = Math.abs(rel);
        const dir = Math.sign(rel);
        const offset = [0, 24, 44];
        const scaleAt = [1, 0.85, 0.72];
        const brightAt = [1, 0.72, 0.52];
        const zAt = [30, 20, 10];

        let x = 0,
          scale = 1,
          opacity = 1,
          z = 10,
          brightness = 1;
        let interactive = false;

        if (depth <= 2) {
          x = dir * offset[depth];
          scale = scaleAt[depth];
          brightness = brightAt[depth];
          z = zAt[depth];
          opacity = 1;
          interactive = depth !== 0;
        } else {
          x = dir * 52;
          scale = 0.62;
          opacity = 0;
          z = 5;
          brightness = 0.5;
        }

        el.style.transform = `translate(-50%, 0) translateX(${x}%) scale(${scale})`;
        el.style.opacity = String(opacity);
        el.style.zIndex = String(z);
        el.style.filter = `brightness(${brightness})`;
        el.style.pointerEvents = rel === 0 || interactive ? "auto" : "none";
      });
    };

    const goTo = (i: number) => {
      current = ((i % n) + n) % n;
      layout();
    };

    slides.forEach((el, i) =>
      el.addEventListener("click", () => {
        if (i !== current) goTo(i);
      }),
    );
    layout();

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (!reduced) {
      let paused = false;
      root.addEventListener("pointerenter", () => (paused = true));
      root.addEventListener("pointerleave", () => (paused = false));
      window.setInterval(() => {
        if (!paused) goTo(current + 1);
      }, 4500);
    }
  });
</script>
