---
interface Props {
  icon: keyof typeof icons;
  title: string;
  body: string;
  badge?: string;
}

const icons = {
  portrait: `<circle cx="12" cy="8.5" r="3.3"/><path d="M5.5 19.5c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="4.5" cy="5" r="1" fill="currentColor" stroke="none"/><circle cx="19.5" cy="4.5" r="1.4" fill="currentColor" stroke="none"/><circle cx="20" cy="10" r="0.9" fill="currentColor" stroke="none"/>`,
  centerStage: `<path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16"/><circle cx="12" cy="10.5" r="2.2"/><path d="M8.5 17c0-2 1.6-3.3 3.5-3.3s3.5 1.3 3.5 3.3"/>`,
  background: `<rect x="3.5" y="5" width="17" height="14" rx="0"/><path d="M3.5 16l4-4 3 3 3.5-4 6.5 6"/><circle cx="16.5" cy="9" r="1.4"/>`,
  studioLight: `<circle cx="13.5" cy="12" r="4.5"/><path d="M5 12H2.5M6 6.5 4.3 4.8M6 17.5l-1.7 1.7M7.2 9.2 5.4 7.4M7.2 14.8l-1.8 1.8"/>`,
  reactions: `<path d="M7 11.5 10 5.2A1.6 1.6 0 0 1 13 6v3.5h4.3a1.7 1.7 0 0 1 1.7 2l-1 5a2 2 0 0 1-2 1.5H9"/><path d="M7 11.5H5.2A1.2 1.2 0 0 0 4 12.7v5.1A1.2 1.2 0 0 0 5.2 19H7z"/>`,
  everywhere: `<rect x="3" y="4.5" width="18" height="12" rx="0"/><path d="M9 20h6M12 16.5V20"/><circle cx="12" cy="10.5" r="2.4"/>`,
} as const;

const { icon, title, body, badge } = Astro.props;
---

<article
  class="group card relative flex flex-col gap-4 p-6 transition-colors duration-200 hover:border-accent/60"
>
  <div
    class="flex h-11 w-11 items-center justify-center border border-accent/25 bg-accent/8 text-accent"
  >
    <svg
      class="h-6 w-6"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={icons[icon]}
    />
  </div>

  <div class="flex flex-col gap-2">
    <div class="flex items-center gap-2.5">
      <h3 class="text-lg font-semibold text-fg">{title}</h3>
      {
        badge && (
          <span class="border border-accent/30 bg-accent/8 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider text-accent">
            {badge}
          </span>
        )
      }
    </div>
    <p class="text-[0.95rem] leading-relaxed text-muted">{body}</p>
  </div>
</article>
