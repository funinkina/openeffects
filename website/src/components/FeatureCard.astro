---

<article
  class="group card relative flex flex-col gap-2 p-6 transition-colors duration-200 hover:border-accent/60"
>
  <div
    class="flex h-11 w-11 items-center justify-center text-accent [&_svg]:h-10 [&_svg]:w-10 [&_svg]:fill-current"
    aria-hidden="true"
    set:html={icons[icon]}
  />

  <div class="flex flex-col gap-2">
    <div class="flex items-center gap-2.5">
      <h3 class="text-lg font-semibold text-fg">{title}</h3>
      {
        badge && (
          <span class="border border-accent/30 bg-accent/8 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider text-accent">
            {badge}
          </span>
        )
      }
    </div>
    <p class="text-[0.95rem] leading-relaxed text-muted">{body}</p>
  </div>
</article>
