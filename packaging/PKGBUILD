# Contributor: Aryan <hello@funinkina.co.in>  (upstream: funinkina/openeffects)

pkgbase=vinoopeneffects
_reponame=vinoOpenEffects  # GitHub archive tarballs unpack to <repo>-<ver>, case preserved
pkgname=('vinoopeneffects-daemon' 'vinoopeneffects-ctl' 'vinoopeneffects')
pkgver=0.1.2
pkgrel=1
pkgdesc='Real-time webcam effects for Linux (PipeWire virtual camera)'
arch=('x86_64')
url='https://github.com/karanshukla/vinoOpenEffects'
license=('GPL-3.0-or-later')
makedepends=(
  'rust'
  'cargo'
  'clang'
  'pkgconf'
  'pipewire'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugin-pipewire'
  'gtk4'
  'libadwaita'
)

source=(
  "$pkgbase-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
  "hand_landmark.onnx::https://github.com/opencv/opencv_zoo/raw/main/models/handpose_estimation_mediapipe/handpose_estimation_mediapipe_2023feb.onnx"
  "palm_detection.onnx::https://github.com/opencv/opencv_zoo/raw/main/models/palm_detection_mediapipe/palm_detection_mediapipe_2023feb.onnx"
  "selfie_segmentation.onnx::https://huggingface.co/onnx-community/mediapipe_selfie_segmentation/resolve/main/onnx/model.onnx"
  "yunet.onnx::https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2026may.onnx"
  "LICENSE.Apache-2.0::https://www.apache.org/licenses/LICENSE-2.0.txt"
  "LICENSE.MIT::https://opensource.org/licenses/MIT"
)
sha256sums=(
  'SKIP'
  'db0898ae717b76b075d9bf563af315b29562e11f8df5027a1ef07b02bef6d81c'
  '78ff51c38496b7fc8b8ebdb6cc8c1abb02fa6c38427c6848254cdaba57fcce7c'
  '3241ac4ad8aa35bdaf33946776db29f7c283a413aa0b0dacb9483594b4531aad'
  'ebafce4e3c118d6554634be5c27ab333b4c047a9a8c3faf1d7cf93101c22f0f0'
  'SKIP'
  'SKIP'
)

prepare() {
  cd "$srcdir/$_reponame-$pkgver"

  # Render service templates (@bindir@ -> /usr/bin)
  sed 's|@bindir@|/usr/bin|g' \
    data/dbus-services/io.github.karanshukla.vinoopeneffects.Daemon.service.in \
    > data/dbus-services/io.github.karanshukla.vinoopeneffects.Daemon.service
  sed 's|@bindir@|/usr/bin|g' data/systemd/vinoopeneffects-daemon.service.in \
    > data/systemd/vinoopeneffects-daemon.service
}

build() {
  cd "$srcdir/$_reponame-$pkgver"

  export CARGO_BUILD_JOBS="$(nproc)"
  cargo build --release --workspace --locked
}

package_vinoopeneffects-daemon() {
  replaces=('openeffectsd')
  conflicts=('openeffectsd')
  depends=(
    'pipewire'
    'wireplumber'
    'gstreamer'
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugin-pipewire'
    'dbus'
  )

  cd "$srcdir/$_reponame-$pkgver"

  install -Dm755 target/release/vinoopeneffects-daemon "$pkgdir/usr/bin/vinoopeneffects-daemon"

  install -Dm644 data/dbus/io.github.karanshukla.vinoopeneffects.Daemon1.xml \
    "$pkgdir/usr/share/dbus-1/interfaces/io.github.karanshukla.vinoopeneffects.Daemon1.xml"
  install -Dm644 data/dbus/io.github.karanshukla.vinoopeneffects.Effects1.xml \
    "$pkgdir/usr/share/dbus-1/interfaces/io.github.karanshukla.vinoopeneffects.Effects1.xml"
  install -Dm644 data/dbus/io.github.karanshukla.vinoopeneffects.Devices1.xml \
    "$pkgdir/usr/share/dbus-1/interfaces/io.github.karanshukla.vinoopeneffects.Devices1.xml"

  install -Dm644 data/dbus-services/io.github.karanshukla.vinoopeneffects.Daemon.service \
    "$pkgdir/usr/share/dbus-1/services/io.github.karanshukla.vinoopeneffects.Daemon.service"

  install -Dm644 data/systemd/vinoopeneffects-daemon.service \
    "$pkgdir/usr/lib/systemd/user/vinoopeneffects-daemon.service"

  install -Dm644 "$srcdir/yunet.onnx" \
    "$pkgdir/usr/share/vinoopeneffects/models/yunet/face_detection_yunet_2026may.onnx"
  install -Dm644 data/models/yunet/manifest.toml \
    "$pkgdir/usr/share/vinoopeneffects/models/yunet/manifest.toml"

  install -Dm644 "$srcdir/selfie_segmentation.onnx" \
    "$pkgdir/usr/share/vinoopeneffects/models/selfie_segmentation/selfie_segmentation.onnx"
  install -Dm644 data/models/selfie_segmentation/manifest.toml \
    "$pkgdir/usr/share/vinoopeneffects/models/selfie_segmentation/manifest.toml"

  install -Dm644 "$srcdir/hand_landmark.onnx" \
    "$pkgdir/usr/share/vinoopeneffects/models/hand_landmark/handpose_estimation_mediapipe_2023feb.onnx"
  install -Dm644 data/models/hand_landmark/manifest.toml \
    "$pkgdir/usr/share/vinoopeneffects/models/hand_landmark/manifest.toml"

  install -Dm644 "$srcdir/palm_detection.onnx" \
    "$pkgdir/usr/share/vinoopeneffects/models/palm_detection/palm_detection_mediapipe_2023feb.onnx"
  install -Dm644 data/models/palm_detection/manifest.toml \
    "$pkgdir/usr/share/vinoopeneffects/models/palm_detection/manifest.toml"

  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/vinoopeneffects-daemon/LICENSE"
  install -Dm644 "$srcdir/LICENSE.Apache-2.0" \
    "$pkgdir/usr/share/licenses/vinoopeneffects-daemon/LICENSE.Apache-2.0"
  install -Dm644 "$srcdir/LICENSE.MIT" \
    "$pkgdir/usr/share/licenses/vinoopeneffects-daemon/LICENSE.MIT"
}

package_vinoopeneffects-ctl() {
  replaces=('openeffectsctl')
  conflicts=('openeffectsctl')
  depends=('vinoopeneffects-daemon' 'dbus')

  cd "$srcdir/$_reponame-$pkgver"

  install -Dm755 target/release/vinoopeneffects-ctl "$pkgdir/usr/bin/vinoopeneffects-ctl"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/vinoopeneffects-ctl/LICENSE"
}

package_vinoopeneffects() {
  replaces=('openeffects')
  conflicts=('openeffects')
  depends=('vinoopeneffects-daemon' 'gtk4' 'libadwaita')

  cd "$srcdir/$_reponame-$pkgver"

  install -Dm755 target/release/vinoopeneffects "$pkgdir/usr/bin/vinoopeneffects"

  install -Dm644 data/icons/io.github.karanshukla.vinoopeneffects.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.karanshukla.vinoopeneffects.svg"
  install -Dm644 data/icons/io.github.karanshukla.vinoopeneffects-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.karanshukla.vinoopeneffects-symbolic.svg"
  install -Dm644 data/applications/io.github.karanshukla.vinoopeneffects.desktop \
    "$pkgdir/usr/share/applications/io.github.karanshukla.vinoopeneffects.desktop"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/vinoopeneffects/LICENSE"
}
